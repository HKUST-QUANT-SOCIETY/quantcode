{
  // QuantCode 项目配置 — OpenCode 入口
  // 详细架构: docs/QuantCode_Design.md
  "$schema": "https://opencode.ai/config.json",

  // Provider 配置由各成员本地 opencode.local.jsonc 提供，不入库
  "provider": {},

  // Plugins（opencode config schema 用 plugin 单数）
  "plugin": ["@dietrichgebert/ponytail"],

  // 让 OpenCode 递归发现 .opencode/groups/**/SKILL.md
  "skills": {
    "paths": [".opencode/groups"]
  },

  // 权限：高风险路径需 ask 或 deny
  "permission": {
    "edit": {
      "vendor/**": "deny",
      "schemas/**": "ask",
      ".opencode/groups/**/skills/**": "ask",
      ".github/workflows/**": "ask"
    },
    "bash": {
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push origin main": "ask"
    }
  },

  // MCP server：组身份由服务端签发的 SSH roster Session Context 决定。
  // 不为每个组复制一个固定 QUANTCODE_GROUP，避免通过选择 MCP server 越权切组。
  "mcp": {
    "quantcode": {
      "type": "local",
      "command": ["python3", "-m", "quantcode.mcp_server"],
      "cwd": "{env:QUANTCODE_ROOT}",
      "environment": {
        "PYTHONPATH": "{env:QUANTCODE_ROOT}"
      },
      "enabled": true
    }
  }
}
