{
  // QuantCode 项目配置 — OpenCode 入口
  // 详细架构: docs/QuantCode_Design.md
  "$schema": "https://opencode.ai/config.json",

  // Provider 配置由各成员本地 opencode.local.jsonc 提供，不入库
  "provider": {},

  // Plugins
  "plugins": ["@dietrichgebert/ponytail"],

  // 让 OpenCode 递归发现 .opencode/groups/**/SKILL.md
  "skills": {
    "paths": [".opencode/groups"]
  },

  // 权限：高风险路径需 ask 或 deny
  "permission": {
    "edit": {
      "vendor/**": "deny",
      "schemas/**": "ask",
      ".opencode/groups/**/skills/**": "ask",
      ".github/workflows/**": "ask"
    },
    "bash": {
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push origin main": "ask"
    }
  },

  // MCP servers（Day 3 尹一帆）
  // quantcode: 暴露 model/risk/factor 等组的量化 tool 给 OpenCode，
  // 入口 quantcode/mcp_server.py（stdin/stdout JSON-RPC）
  "mcp": {
    "quantcode": {
      "type": "local",
      "command": ["python", "-m", "quantcode.mcp_server"],
      "environment": {
        // 第一版硬编码 model 组；Day 4 改成从 SSH key 注入（架构 §2.1）
        "QUANTCODE_GROUP": "model",
        // 显式 PYTHONPATH 防止 command 直接调用时找不到 quantcode 包
        "PYTHONPATH": "."
      },
      "enabled": true
    }
  }
}
