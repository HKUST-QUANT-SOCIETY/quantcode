{
  // QuantCode 项目配置 — OpenCode 入口
  // 详细架构: docs/QuantCode_Design.md
  "$schema": "https://opencode.ai/config.json",

  // Provider 配置由各成员本地 opencode.local.jsonc 提供，不入库
  "provider": {},

  // Plugins（opencode config schema 用 plugin 单数）
  "plugin": ["@dietrichgebert/ponytail"],

  // 让 OpenCode 递归发现 .opencode/groups/**/SKILL.md
  "skills": {
    "paths": [".opencode/groups"]
  },

  // 权限：高风险路径需 ask 或 deny
  "permission": {
    "edit": {
      "vendor/**": "deny",
      "schemas/**": "ask",
      ".opencode/groups/**/skills/**": "ask",
      ".github/workflows/**": "ask"
    },
    "bash": {
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push origin main": "ask"
    }
  },

  // MCP servers（Day 3 尹一帆 / Day 4 刘炽 扩展 / Day 5 补 risk+factor）
  // quantcode-<group>: 暴露各组 Python tool 给 OpenCode（stdin/stdout JSON-RPC）
  // OpenCode 启动后 Agent 可调用对应 MCP tool；切换组用不同 server 名即可。
  // 6 组各一个命名 server，QUANTCODE_GROUP 在此固定（切组=选不同 server）。
  "mcp": {
    "quantcode-model": {
      "type": "local",
      "command": ["python3", "-m", "quantcode.mcp_server"],
      "environment": {
        "QUANTCODE_GROUP": "model",
        "PYTHONPATH": "."
      },
      "enabled": true
    },
    "quantcode-risk": {
      "type": "local",
      "command": ["python3", "-m", "quantcode.mcp_server"],
      "environment": {
        "QUANTCODE_GROUP": "risk",
        "PYTHONPATH": "."
      },
      "enabled": true
    },
    "quantcode-factor": {
      "type": "local",
      "command": ["python3", "-m", "quantcode.mcp_server"],
      "environment": {
        "QUANTCODE_GROUP": "factor",
        "PYTHONPATH": "."
      },
      "enabled": true
    },
    "quantcode-strategy": {
      "type": "local",
      "command": ["python3", "-m", "quantcode.mcp_server"],
      "environment": {
        "QUANTCODE_GROUP": "strategy",
        "PYTHONPATH": "."
      },
      "enabled": true
    },
    "quantcode-fundamental": {
      "type": "local",
      "command": ["python3", "-m", "quantcode.mcp_server"],
      "environment": {
        "QUANTCODE_GROUP": "fundamental",
        "PYTHONPATH": "."
      },
      "enabled": true
    },
    "quantcode-options": {
      "type": "local",
      "command": ["python3", "-m", "quantcode.mcp_server"],
      "environment": {
        "QUANTCODE_GROUP": "options",
        "PYTHONPATH": "."
      },
      "enabled": true
    }
  }
}
